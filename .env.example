# Supabase Database Configuration Example
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key

# Admin Notification Settings
ADMIN_NOTIFICATION_EMAIL=info@binrasoolenterprises.com
NEXT_PUBLIC_SITE_URL=https://binrasoolenterprises.com

# WhatsApp Factory Alert Settings
NEXT_PUBLIC_FACTORY_WHATSAPP=923338600000
FACTORY_WHATSAPP_NUMBER=923338600000
# Optional: Zapier / Make / n8n / Discord webhook for instant team alerts
WHATSAPP_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
# Optional: Meta WhatsApp Cloud API credentials
META_WHATSAPP_TOKEN=your_meta_system_user_token
META_WHATSAPP_PHONE_ID=your_meta_phone_number_id

# Email Dispatch Option 1: Resend (Recommended for Next.js)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Bin Rasool Enterprises <orders@binrasoolenterprises.com>

# Email Dispatch Option 2: Standard SMTP (Gmail, Zoho, Hostinger, Outlook, etc.)
SMTP_HOST=smtp.yourmailserver.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@binrasoolenterprises.com
SMTP_PASS=your_email_password_or_app_password
SMTP_FROM="Bin Rasool Enterprises" <info@binrasoolenterprises.com>
